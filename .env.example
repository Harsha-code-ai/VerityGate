# Copy to .env and edit. NEVER commit .env. All values below are placeholders.

# ---- Required for the application to answer questions ----
LLM_PROVIDER=            # anthropic | openai | ollama
LLM_MODEL=               # a model name enabled for YOUR account, e.g. check your provider's model list
LLM_API_KEY=             # required for anthropic/openai; leave empty for ollama

# ---- Required when APP_ENV=production (>= 32 random characters) ----
SECRET_KEY=change-me
# generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- Common options ----
APP_ENV=development            # development | production
FRONTEND_PORT=8080
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:8080
ALLOW_REGISTRATION=true        # set false after creating your account(s)
LOG_LEVEL=INFO

# ---- LLM extras (optional) ----
LLM_BASE_URL=                  # OpenAI-compatible servers / proxies
OLLAMA_BASE_URL=http://ollama:11434   # Docker; use http://host.docker.internal:11434 for Ollama running on Windows itself

# ---- Retrieval / verification tuning (optional) ----
RETRIEVAL_TOP_K=6
RERANKER_ENABLED=false
OCR_ENABLED=true               # read scanned PDFs with Tesseract (installed in the Docker image by default)
OCR_LANGUAGE=eng               # Tesseract language code(s), e.g. eng+deu (language data must be installed)
PRELOAD_MODELS=true            # load embedding/NLI models at startup instead of on the first request
MAX_DOCUMENTS_PER_USER=100

# ---- Models (all of these run locally inside the backend container; the first start downloads them) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_QUERY_PREFIX=        # e.g. "query: " for E5 models
EMBEDDING_DOCUMENT_PREFIX=     # e.g. "passage: " for E5 models
NLI_MODEL=cross-encoder/nli-deberta-v3-small
NLI_LABEL_ORDER=               # only if the NLI model's labels are generic, e.g. contradiction,entailment,neutral
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # used only when RERANKER_ENABLED=true

# ---- Verification thresholds: STARTING VALUES, not calibrated on your documents. ----
# Run `docker compose --profile test run --rm tests python -m evaluation.run --mode real` and tune using the report.
ENTAILMENT_THRESHOLD=0.80
CONTRADICTION_THRESHOLD=0.85
CONFLICT_THRESHOLD=0.90
VERIFY_MAX_UNITS=6
MAX_RETRIES=2                  # hard-capped at 2
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MINUTE=30
AUDIT_STORE_QUESTIONS=false
MLFLOW_TRACKING_URI=
INSTALL_OCR=true               # build-time: install Tesseract in the backend image
